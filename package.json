{
  "name": "iobroker.meross-local",
  "version": "0.0.1",
  "description": "Connect locally with meross smart plugs",
  "author": {
    "name": "revati",
    "email": "dev.revati.at@gmail.com"
  },
  "contributors": [
    {
      "name": "revati"
    }
  ],
  "homepage": "https://github.com/dev-revati/ioBroker.meross-local",
  "license": "MIT",
  "keywords": [
    "meross",
    "smart plug",
    "plug",
    "consumption",
    "switch"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-revati/ioBroker.meross-local.git"
  },
  "engines": {
    "node": ">= 24"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/iobroker": "npm:@iobroker/types@^7.2.5",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/dev-revati/ioBroker.meross-local/issues"
  },
  "readmeFilename": "README.md"
}